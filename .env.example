# Required in production. Change these values before deploying.
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-password
APP_ENV=production

# Keep SQLite on a persistent host volume. Local default is backend/cement_store.db.
DATABASE_PATH=/data/cement_store.db

# Hosting platforms provide PORT automatically. Local default is 8000.
PORT=8000

# Optional. Leave empty when the UI and API use the same hosted URL.
ALLOWED_ORIGINS=

# A domain name pointed to the server's public IP, for example:
# DOMAIN=billing.example.com
DOMAIN=
